// Cloudflare Workers config: serves the built frontend as static assets.
// Workers Builds runs `build.command` and then deploys `assets.directory`.
// The data snapshot is pulled from the GitHub Pages deployment (refreshed
// monthly by .github/workflows/pages.yml, and on every push to main) so both
// hosts serve the same dataset; the committed fixture firms.json is the
// fallback. Build logic lives in scripts/cf_build.sh, not inline here --
// it retries the fetch against a freshness check, because this build and
// pages.yml's deploy both trigger on the same push with no ordering between
// them (see that script's docstring for the real staleness this caused).
{
  "name": "advisorapp",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./frontend/dist",
    // Serves firm/105958.html at /firm/105958 — no trailing slash, matching
    // the URLs in sitemap.xml and the canonical tags. This is the current
    // default, pinned explicitly because the pre-rendered pages are useless
    // if a future default change routes these to the SPA shell instead.
    // Unknown CRDs still have no file and fall through to not_found_handling.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application"
  },
  "build": {
    "command": "bash scripts/cf_build.sh"
  }
}
