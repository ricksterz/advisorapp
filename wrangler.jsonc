// Cloudflare Workers config: serves the built frontend as static assets.
// Workers Builds runs `build.command` and then deploys `assets.directory`.
// The data snapshot is pulled from the GitHub Pages deployment (refreshed
// monthly by .github/workflows/pages.yml) so both hosts serve the same
// dataset; the committed fixture firms.json is the fallback.
{
  "name": "advisorapp",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./frontend/dist",
    "not_found_handling": "single-page-application"
  },
  "build": {
    "command": "curl -fsSL https://ricksterz.github.io/advisorapp/firms.json -o frontend/public/firms.json || echo 'live data unavailable, using committed firms.json'; cd frontend && npm ci && npm run build"
  }
}
